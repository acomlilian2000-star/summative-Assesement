doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Login Form

    link(rel="stylesheet" href="/css/login.css")

  body

    #loginCard.login-container
      h2 Login

      form#loginForm(novalidate=true)
        .form-group
          input#loginIdentity(type="text" name="email" placeholder="Email ")
          .error-message Please enter your email 

        .form-group
          input#loginPassword(type="password" name="password" placeholder="Password")
          .error-message Password is required

        button.btn-login(type="submit") Login

      p.footer-text
        | Don’t have an account? - 
        a(href="/signup") Signup

    #congratsCard.congrats-card(style="display: none;")
      h1 Congratulations!
      p You have successfully signed into the Refactory system. Feel at home

    script.
      const loginForm = document.getElementById('loginForm');
      const loginCard = document.getElementById('loginCard');
      const congratsCard = document.getElementById('congratsCard');

      loginForm.addEventListener('submit', function(e) {
          e.preventDefault();

          const identity = document.getElementById('loginIdentity');
          const password = document.getElementById('loginPassword');

          function validateField(inputElement, condition) {
              if (condition) {
                  inputElement.classList.remove('error');
                  inputElement.classList.add('success');
              } else {
                  inputElement.classList.remove('success');
                  inputElement.classList.add('error');
              }
          }

          validateField(identity, identity.value.trim() !== "");
          validateField(password, password.value.trim().length >= 4);

          const hasErrors = document.querySelectorAll('input.error').length > 0;

          if (!hasErrors) {
              loginCard.style.display = 'none';
              congratsCard.style.display = 'block';

              setTimeout(() => {
                  window.location.href = '/dashboard'; 
              }, 1500);
          }
      });

      document.querySelectorAll('input').forEach(input => {
          input.addEventListener('input', function() {
              if (this.classList.contains('error')) {
                  this.classList.remove('error');
              }
          });
      });